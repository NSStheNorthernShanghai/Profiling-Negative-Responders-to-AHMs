  distinct(Drug, Feature, Feature_facet, TotalImportance) %>%
  arrange(Drug, TotalImportance) %>%
  pull(Feature_facet)

plot_df <- plot_df %>%
  mutate(
    Feature_facet = factor(Feature_facet, levels = feature_levels)
  )


p <- ggplot(plot_df,aes(x = Importance_Type, y = Feature_facet, fill = Importance)) +
  scale_y_discrete(
    labels = function(x) sub("___.*$", "", x)
  ) +
  geom_tile(color = "white") +
  facet_wrap(~Drug, scales = "free_y") +
  scale_fill_gradient(low = "white", high = "steelblue", na.value = "white") +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, face = "bold"),
    axis.text.y = element_text(size = 8),
    strip.text = element_text(face = "bold", size = 12),
    panel.grid = element_blank()
  ) +
  labs(
    title = "Normalized Feature Importance Heatmap Across Drugs",
    x = "Importance Type",
    y = "Feature",
    fill = "Normalized Importance (0-1)"
  )

ggsave(
  filename = "feature_importance_heatmap.pdf",
  plot = p,
  width = 12,
  height = 8
)

merged_all_list_scaled <- lapply(merged_all_list_scaled, function(df) {
  df %>%
    mutate(
      across(
        any_of(importance_cols),
        ~ ifelse(is.na(.x), 0, .x)
      )
    )
})

merged_all_list_scaled <- lapply(merged_all_list_scaled, function(df) {
  df %>%
    mutate(
      Total_importance = rowSums(
        across(all_of(importance_cols)),
        na.rm = TRUE
      )
    ) %>%
    arrange(desc(Total_importance))
})

save(merged_all_list_scaled, file = "merged_all_list_scaled.Rdata")

               "Diabetes_Mellitus","eGFR","CKD",
               "dyslipidemia")

mice_impute <- function(df, seed = 123) {
  uid <- df$patient_uid
  vars_needed <- c(predictors, responses)
  df_sub <- df[, vars_needed, drop = FALSE]
  df_sub <- df_sub %>% 
    mutate(across(where(is.character), as.factor))
  df_sub[df_sub == ""] <- NA
  meth <- make.method(df_sub)
  
  for(v in names(df_sub)) {
    if(is.numeric(df_sub[[v]])) {
      meth[v] <- "pmm"
    } else if(nlevels(as.factor(df_sub[[v]])) == 2) {
      meth[v] <- "logreg"  
    } else {
      meth[v] <- "polyreg"  
    }
  }
  
  imp <- mice(df_sub, m = 2, method = meth, maxit = 10, seed = seed, printFlag = FALSE)
  
  fit_formula <- as.formula(
    paste(responses, "~", paste(predictors, collapse = " + "))
  )
  
  models <- lapply(1:imp$m, function(k) {
    completed_k <- complete(imp, k)
    lm(fit_formula, data = completed_k)
  })
  
  pooled <- pool(as.mira(models))
  pooled_summary <- summary(pooled, conf.int = TRUE)
  completed_long <- complete(imp, action = "long", include = FALSE)
  
  return(list(
    imp = imp,
    models = models,
    pooled = pooled,
    pooled_summary = pooled_summary,
    completed_long = completed_long
  ))
}



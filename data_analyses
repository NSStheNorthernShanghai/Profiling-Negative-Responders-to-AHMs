library(xgboost)
library(dplyr)
library(Ckmeans.1d.dp)
library(Matrix)
library(caret)

myCl <- makeCluster(detectCores() - 3)
registerDoParallel(myCl)

xgb.grid <- expand.grid(
  nrounds = c(300, 500, 800),
  max_depth = c(4, 6, 8),
  eta = c(0.05, 0.1, 0.2),
  subsample = c(0.6, 0.8),
  colsample_bytree = c(0.4, 0.6, 0.8),
  min_child_weight = c(1, 3, 5),
  gamma = c(0, 1)
)


xgb.control <- trainControl(
  method = "cv",
  number = 5,
  verboseIter = TRUE,
  returnData = FALSE,
  returnResamp = "none",
  allowParallel = TRUE
)

best_params_list <- list()

for(name in names(data_list)){ 
  cat("Processing:", name, "\n") 
  
  df <- data_list[[name]] 
  y_train <- df[["sbpTTR1"]]
  X_train <- df[, predictors] 
  X_train_mat <- model.matrix(~ ., data = X_train)
  X_train_mat <- X_train_mat[, colnames(X_train_mat) != "(Intercept)", drop = FALSE] 
  
  # Grid search + CV 
  xgb.train.model <- train( 
    x = X_train_mat, 
    y = y_train, 
    method = "xgbTree", 
    trControl = xgb.control, 
    tuneGrid = xgb.grid,
    metric = "RMSE")
  
  best_params <- xgb.train.model$bestTune 
  dtrain <- xgb.DMatrix(data = X_train_mat, label = y_train)
  
  params <- list(
    eta = best_params$eta,
    max_depth = best_params$max_depth,
    gamma = best_params$gamma,
    min_child_weight = best_params$min_child_weight,
    subsample = best_params$subsample,
    colsample_bytree = best_params$colsample_bytree,
    lambda = 1,
    alpha = 0,
    objective = "reg:squarederror",
    eval_metric = "rmse",
    nthread = detectCores() - 3
  )
  
  xgb.cv.model <- xgb.cv(
    params = params,
    data = dtrain,
    nrounds = 5000,
    nfold = 10,
    showsd = TRUE,
    metrics = "rmse",
    stratified = FALSE,
    verbose = TRUE,
    print_every_n = 10L,
    early_stopping_rounds = 100
  )
  
  best_nrounds <- xgb.cv.model$best_iteration
  cat("Best nrounds for", name, ":", best_nrounds, "\n")
  best_params_list[[name]] <- list(
    bestTune = best_params,
    best_nrounds = best_nrounds,
    best_rmse = min(xgb.cv.model$evaluation_log$test_rmse_mean, na.rm = TRUE)
  )
  
  
  final_model <- xgboost(
    data = X_train_mat,
    label = y_train,
    max.depth = best_params$max_depth,
    eta = best_params$eta,
    nrounds = best_nrounds,
    gamma = best_params$gamma,
    min_child_weight = best_params$min_child_weight,
    subsample = best_params$subsample,
    colsample_bytree = best_params$colsample_bytree,
    lambda = 1,
    alpha = 0,
    objective = "reg:squarederror",
    eval_metric = "rmse",
    verbose = 0,
    nthread = detectCores() - 3
  )
  
  importance_matrix <- xgb.importance(feature_names = colnames(X_train_mat), model = final_model)
  
  importance_matrix$OriginalFeature <- sapply(importance_matrix$Feature, function(x) {
    matched <- predictors[sapply(predictors, function(p) grepl(p, x, fixed = TRUE))]
    if(length(matched) > 0) matched[1] else x
  })
  
  importance_summary <- importance_matrix %>%
    group_by(OriginalFeature) %>%
    summarise(TotalGain = sum(Gain), .groups = "drop") %>%
    arrange(desc(TotalGain))
  
  write.csv(importance_summary, file = paste0("XGB_importance_", name, ".csv"), row.names = FALSE)
  write.csv(importance_matrix, file = paste0("XGB_importance_c_", name, ".csv"), row.names = FALSE)
  # 
  pdf(file = paste0("XGB_importance_", name, ".pdf"), width = 10, height = 8)
  importance_plot <- importance_matrix[order(-importance_matrix$Gain), ]
  xgb.plot.importance(importance_plot, rel_to_first = TRUE, xlab = "Relative Gain",
                      main = paste("XGBoost Feature Importance -", name))
  dev.off()
}

